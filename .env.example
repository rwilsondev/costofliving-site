# Example environment variables for SAML scaffold
# Copy this file to `.env` and fill in real values. DO NOT commit your real `.env` file to the repository.

# IdP SSO URL (Single Sign-On Service / Redirect or POST endpoint)
SAML_ENTRY_POINT=https://idp.example.com/sso

# SP issuer / entity ID (set to your public SP identifier)
SAML_ISSUER=urn:your:sp
SAML_ENTITY_ID=urn:your:sp

# Assertion Consumer Service (ACS) URL registered with IdP
SAML_CALLBACK=https://your-domain.example.com/auth/saml/callback

# IdP signing certificate (PEM). For .env, either put the PEM on a single line with \n for newlines, or keep cert in a separate file and load it into the env at runtime.
# Example using escaped newlines:
# SAML_CERT="-----BEGIN CERTIFICATE-----\nMIIC...IDAQAB\n-----END CERTIFICATE-----"
SAML_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_IDP_CERT_PEM\n-----END CERTIFICATE-----"

# Session secret for express-session (use a secure random value in production)
SESSION_SECRET=replace_with_strong_random_secret

# Server port
PORT=3000

# Set to 'production' in your production environment to enable secure cookies
NODE_ENV=development

# Notes:
# - Do NOT commit your real .env file or secrets to version control.
# - For local development you can export these variables in your shell or use a dotenv loader (npm i dotenv) and require('dotenv').config() in server.js.
